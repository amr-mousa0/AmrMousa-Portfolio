---
import { ClientRouter } from 'astro:transitions';
import StickyCTA from '../components/astro/StickyCTA.astro';
import Analytics from '../components/astro/Analytics.astro';
import '../styles/tailwind.css';
interface Props {
  title: string;
  description?: string;
  lang?: string;
  dir?: string;
}
const { 
  title, 
  description = "Amr Mousa — Expert Data Analyst, BI Specialist & Marketing Strategist. Transforming complex data into high-ROI business decisions in Egypt & Worldwide. عمرو موسى — خبير تحليل البيانات وتطوير الأعمال.",
  lang = Astro.currentLocale || 'en' 
} = Astro.props;
let { dir = 'ltr' } = Astro.props;
if (lang === 'ar') dir = 'rtl';

const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  
  <!-- ── Advanced SEO & GEO Meta Tags ────────────────────────────── -->
  <meta name="description" content={description} />
  <meta name="keywords" content="Amr Mousa, Data Analyst Amr Mousa, Marketing Strategist Egypt, Power BI Expert Cairo, SQL Analyst, Business Intelligence Egypt, عمرو موسى, محلل بيانات عمرو موسى, خبير Power BI مصر, Data Visualization" />
  <meta name="author" content="Amr Mousa" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href={Astro.url ? Astro.url.href : "https://amrmousa.com"} />

  <!-- GEO Location Tags (Egypt & MENA Targeting) -->
  <meta name="geo.region" content="EG-C" />
  <meta name="geo.placename" content="Cairo" />
  <meta name="geo.position" content="30.0444;31.2357" />
  <meta name="ICBM" content="30.0444, 31.2357" />

  <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  
  <!-- OpenGraph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${import.meta.env.BASE_URL}images/Amr-Mousa.JPG`} />
  <meta property="og:url" content={Astro.url ? Astro.url.href : "https://amrmousa.com"} />
  <meta property="og:site_name" content="Amr Mousa — Portfolio" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="ar_EG" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${import.meta.env.BASE_URL}images/Amr-Mousa.JPG`} />

  <!-- ── Resource Preloads & Core Web Vitals ─────────────────────── -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />

  <link
    href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Poppins:wght@300;400;600;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400;1,600&family=Cairo:wght@300;400;600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />
  <!-- Lighthouse & Bot bypass for Luxury Loader (speeds up index times & PSI scores) -->
  <script is:inline>
    if (/Lighthouse|Chrome-Lighthouse|Googlebot/i.test(navigator.userAgent)) {
      document.documentElement.classList.add('no-loader');
    }
  </script>
  <script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
    window.BASE_URL = baseUrl;
  </script>
  <script src={`${import.meta.env.BASE_URL}js/translations.js`} is:inline defer></script>
  <script src={`${import.meta.env.BASE_URL}js/main.js`} is:inline defer></script>
  <Analytics />

  <!-- ── Schema.org JSON-LD Structured Data (Google Rich Snippets) ── -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://amrmousa.com/#person",
          "name": "Amr Mousa",
          "alternateName": "عمرو موسى",
          "jobTitle": ["Data Analyst", "Marketing Strategist", "Business Intelligence Specialist"],
          "url": "https://amrmousa.com",
          "image": "https://amrmousa.com/images/Amr-Mousa.JPG",
          "sameAs": [
            "https://github.com/amr-mousa0",
            "https://www.linkedin.com/in/amr-mousa0"
          ],
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cairo",
            "addressCountry": "EG"
          },
          "knowsAbout": [
            "Data Analytics", "Power BI", "SQL", "Marketing Strategy", "Media Buying", "Meta Ads", "Data Cleaning", "Business Intelligence"
          ],
          "description": "Expert Data Analyst and Marketing Strategist based in Cairo, Egypt. Specializing in Power BI dashboards, SQL data modeling, and high-ROI marketing campaign optimization."
        },
        {
          "@type": "ProfessionalService",
          "@id": "https://amrmousa.com/#service",
          "name": "Amr Mousa — Data Analytics & Marketing Consulting",
          "url": "https://amrmousa.com",
          "logo": "https://amrmousa.com/images/Amr-Mousa.JPG",
          "image": "https://amrmousa.com/images/Amr-Mousa.JPG",
          "description": "Professional consulting in Power BI, SQL database modeling, advanced Excel automation, and Meta Ads media buying.",
          "provider": {
            "@id": "https://amrmousa.com/#person"
          },
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cairo",
            "addressCountry": "EG"
          },
          "areaServed": ["EG", "SA", "AE", "US", "GB", "Worldwide"],
          "priceRange": "$$$",
          "telephone": "+201017749925"
        },
        {
          "@type": "OfferCatalog",
          "@id": "https://amrmousa.com/#catalog",
          "name": "Data & Marketing Services Catalog",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Data Analytics & BI Dashboards",
                "description": "Transforming raw data into interactive Power BI and SQL dashboards that reveal bottlenecks and maximize ROI."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Marketing Strategy & Media Buying",
                "description": "Managing and scaling paid Meta Ads campaigns to eliminate wasted ad spend and drive qualified leads."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Workflow & Business Automation",
                "description": "Connecting CRM, spreadsheets, and apps via Zapier and Make.com to automate repetitive manual tasks."
              }
            }
          ]
        }
      ]
    }
  </script>

  <ClientRouter />
</head>
<body class={currentPath.includes('methodology') ? 'methodology-page' : ''}>
  <!-- LUXURY PAGE LOADER -->
  <div id="luxury-loader" aria-busy="true" aria-label="Loading site">
    <div class="loader-brand" data-i18n="hero_name">Amr Mousa</div>
    <div class="loader-job-title" data-i18n="hero_job">DATA ANALYST & MARKETING STRATEGIST</div>
    <div class="loader-line-container">
      <div class="loader-line"></div>
    </div>
  </div>

  <header class="luxury-header" aria-label="Site Header">
    <div class="header-left">
      <div class="header-brand" role="button" tabindex="0" onclick="goToSection('#hero')" onkeydown="if(event.key==='Enter'||event.key===' ') goToSection('#hero')">
        <span class="brand-dot"></span>
        <span class="brand-text" data-i18n="hero_name">Amr Mousa</span>
      </div>
    </div>

    <nav class="header-nav" aria-label="Desktop Navigation">
      <button class={`nav-link ${(currentPath === import.meta.env.BASE_URL || currentPath === import.meta.env.BASE_URL.slice(0, -1) || currentPath === '/') ? 'active' : ''}`} data-section="#hero" data-i18n="nav_home" onclick="goToSection('#hero')">Home</button>
      <a href={`${import.meta.env.BASE_URL}methodology`} class={`nav-link ${currentPath.includes('/methodology') ? 'active' : ''}`} data-i18n="nav_methodology">Methodology</a>
      <button class="nav-link" data-section="#services" data-i18n="nav_services" onclick="goToSection('#services')">Services</button>
      <button class="nav-link" data-section="#projects" data-i18n="nav_projects" onclick="goToSection('#projects')">Projects</button>
      <button class="nav-link" data-section="#contact" data-i18n="nav_contact" onclick="goToSection('#contact')">Contact</button>
    </nav>

    <div class="header-controls">
      <button id="langBtn" class="icon-btn lang-toggle-btn" aria-label="Toggle language">AR</button>
      <button id="themeBtn" class="icon-btn" aria-label="Toggle theme">🌙</button>
      <button id="muteBtn" class="icon-btn" aria-label="Mute sounds">🔊</button>
      <button id="menuBtn" class="icon-btn menu-toggle-btn" aria-label="Open menu">☰</button>
    </div>
  </header>

  <!-- drawer (left) -->
  <nav id="drawer" class="drawer collapsed" aria-label="Site sections" aria-hidden="true">
    <button id="closeBtn" class="icon-btn close-btn" aria-label="Close menu">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <div class="mini-dot" aria-hidden="true"></div>
    <div class="menu menu-centered" role="menu" aria-orientation="vertical">
      <div class={`menu-item ${(currentPath === import.meta.env.BASE_URL || currentPath === import.meta.env.BASE_URL.slice(0, -1) || currentPath === '/') ? 'active' : ''}`} data-target="#hero" role="menuitem" tabindex="0">
        <div class="icon-box"><i class="fa-solid fa-house-chimney"></i></div>
        <div class="label" data-i18n="nav_home">Home</div>
      </div>
      <a href={`${import.meta.env.BASE_URL}methodology`} class={`menu-item ${currentPath.includes('/methodology') ? 'active' : ''}`} role="menuitem" tabindex="0" style="text-decoration: none; color: inherit;">
        <div class="icon-box"><i class="fa-solid fa-user-tie"></i></div>
        <div class="label" data-i18n="nav_methodology">Methodology</div>
      </a>
      <div class="menu-item" data-target="#services" role="menuitem" tabindex="0">
        <div class="icon-box"><i class="fa-solid fa-gears"></i></div>
        <div class="label" data-i18n="nav_services">Services</div>
      </div>
      <div class="menu-item" data-target="#projects" role="menuitem" tabindex="0">
        <div class="icon-box"><i class="fa-solid fa-briefcase"></i></div>
        <div class="label" data-i18n="nav_projects">Projects</div>
      </div>
      <div class="menu-item" data-target="#contact" role="menuitem" tabindex="0">
        <div class="icon-box"><i class="fa-solid fa-envelope"></i></div>
        <div class="label" data-i18n="nav_contact">Contact</div>
      </div>
    </div>
  </nav>

  <!-- decorative shapes -->
  <div class="wave-top" aria-hidden="true"></div>

  <main id="main" aria-label="Main content">
    <slot />
  </main>
  
  <StickyCTA />
  <script src="../utils/cleanNavigation.js"></script>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initGlobalAnimations() {
      // Select all anim-child elements globally
      const elements = document.querySelectorAll('.anim-child');
      
      elements.forEach((el) => {
        // Get transition delay from style attribute if it exists
        const styleAttr = el.getAttribute('style') || '';
        const match = styleAttr.match(/transition-delay:\s*([\d\.]+)s/);
        const delay = match ? parseFloat(match[1]) : 0;

        // Animate with GSAP ScrollTrigger
        gsap.fromTo(el,
          { y: 25, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.8,
            delay: delay,
            ease: "power2.out",
            scrollTrigger: {
              trigger: el,
              scroller: "main",
              start: "top 92%", // Starts when top of element is 92% down the viewport
              toggleActions: "play none none none"
            }
          }
        );
      });
    }

    // Bootstrap global animations
    initGlobalAnimations();

    // Re-run on Astro view transitions
    document.addEventListener('astro:page-load', () => {
      initGlobalAnimations();
      ScrollTrigger.refresh();
    });
  </script>
</body>
</html>
