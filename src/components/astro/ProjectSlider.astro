---
import { Image } from 'astro:assets';
import fallbackImg from '../../assets/projects/coffee.jpg';

interface Props {
  projects: any[];
}

const { projects } = Astro.props;

// Dynamically discover all images in the projects directory at build-time
const allImages = import.meta.glob('../../assets/projects/*.{png,jpg,jpeg,svg,webp}', { eager: true });
const allProjectImages = import.meta.glob('../../assets/images/**/*.{png,jpg,jpeg,svg,webp,PNG,JPG,JPEG,SVG,WEBP}', { eager: true });

function resolveAsset(url: string) {
  if (!url) return fallbackImg;
  if (typeof url === 'string' && (url.startsWith('http://') || url.startsWith('https://'))) {
    return url;
  }
  const decoded = decodeURIComponent(url);
  
  if (allImages[decoded]) {
    return (allImages[decoded] as any).default;
  }
  if (allImages[url]) {
    return (allImages[url] as any).default;
  }

  const relativePath = decoded.replace('/images/', '../../assets/images/');
  if (allProjectImages[relativePath]) {
    return (allProjectImages[relativePath] as any).default;
  }
  if (allProjectImages[decoded]) {
    return (allProjectImages[decoded] as any).default;
  }

  return fallbackImg;
}

function resolveProjectIcon(project: any): string {
  if (project.icon && project.icon.trim() !== '') return project.icon;

  const tagsStr = (project.tags || project.tech || []).join(' ').toLowerCase();
  const titleStr = (project.titleEn || project.title || '').toLowerCase();
  const allStr = `${tagsStr} ${titleStr}`;

  if (allStr.includes('walmart') || allStr.includes('sales') || allStr.includes('retail')) {
    return 'fa-solid fa-chart-column';
  }
  if (allStr.includes('sql') || allStr.includes('database') || allStr.includes('postgres') || allStr.includes('query')) {
    return 'fa-solid fa-database';
  }
  if (allStr.includes('power bi') || allStr.includes('powerbi') || allStr.includes('dashboard') || allStr.includes('bi')) {
    return 'fa-solid fa-chart-pie';
  }
  if (allStr.includes('python') || allStr.includes('pandas') || allStr.includes('data analysis')) {
    return 'fa-brands fa-python';
  }
  if (allStr.includes('excel') || allStr.includes('sheet')) {
    return 'fa-solid fa-file-excel';
  }
  if (allStr.includes('crm') || allStr.includes('erp') || allStr.includes('management')) {
    return 'fa-solid fa-users-gear';
  }

  return 'fa-solid fa-layer-group';
}

const cleanBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<div class="project-slider-wrapper">
  <div class="slider-controls">
    <button class="slider-btn prev-btn" aria-label="Previous project">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
    <button class="slider-btn next-btn" aria-label="Next project">
      <i class="fa-solid fa-chevron-right"></i>
    </button>
  </div>

  <div class="project-slider">
    {projects.map((project) => {
      const imgKey = project.imagePath || '';
      const matchedAsset = allImages[imgKey] as any;
      const localAsset = matchedAsset ? matchedAsset.default : fallbackImg;
      const cleanId = project.id.split('-')[0];
      const rawCover = project.imagePath || project.image || project.cover || (project.images && project.images.length > 0 ? project.images[0] : null);
      const displayImg = rawCover ? resolveAsset(rawCover) : localAsset;

      const currentLocale = Astro.currentLocale || 'en';
      const displayTitle = currentLocale === 'ar' ? (project.titleAr || project.title) : (project.titleEn || project.title);
      const displayDesc = currentLocale === 'ar' ? (project.descriptionAr || project.description) : (project.descriptionEn || project.description);
      const cardHref = `${cleanBase}/projects/${project.id}`;

      return (
        <article class="project-card-wrapper">
          <a href={cardHref} onclick={`trackClick('project_click', { project_id: '${project.id}' })`} class="project-card" aria-label={`View ${project.title} case study`}>
            
            {/* ── Image area ── */}
            <div class="project-card-image">
              <Image
                src={displayImg}
                alt={project.title}
                width={440}
                height={240}
                quality={55}
                format="webp"
                class="slide-img active"
                loading="lazy"
              />
              <div class="img-gradient"></div>
            </div>

            <span class="card-icon">
              <i class={resolveProjectIcon(project)}></i>
            </span>

            {/* ── Text content ── */}
            <div class="project-card-content">
              <span class="project-badge" data-i18n={`project_${cleanId}_category`}>{project.category}</span>
              <h3 
                class="project-title" 
                data-title-en={project.titleEn || project.title} 
                data-title-ar={project.titleAr || project.title} 
                data-i18n={`project_${cleanId}_title`}
              >
                {displayTitle}
              </h3>
              <p 
                class="project-hook" 
                data-desc-en={project.descriptionEn || project.description} 
                data-desc-ar={project.descriptionAr || project.description} 
                data-i18n={`project_${cleanId}_desc`}
              >
                {displayDesc}
              </p>

              <div class="project-tags">
                {(project.tech || project.tags || []).slice(0, 3).map((t: string) => (
                  <span class="tag">{t}</span>
                ))}
              </div>

              <div class="card-footer">
                <span class="view-cta">
                  <span data-i18n="service_explore">View Case Study</span>
                  <i class="fa-solid fa-arrow-right"></i>
                </span>
              </div>
            </div>

          </a>
        </article>
      );
    })}
  </div>
</div>

<script>
  // ── Horizontal card slider ──────────────────────────────────────
  function initSlider() {
    document.querySelectorAll('.project-slider-wrapper').forEach(wrapper => {
      const slider = wrapper.querySelector('.project-slider') as HTMLElement;
      const prev   = wrapper.querySelector('.prev-btn');
      const next   = wrapper.querySelector('.next-btn');
      if (!slider || !prev || !next) return;

      const scroll = (dir: number) => {
        const card = slider.querySelector('.project-card-wrapper') as HTMLElement;
        const gap  = parseInt(getComputedStyle(slider).gap) || 20;
        const step = card ? card.offsetWidth + gap : 320;
        const rtl  = document.documentElement.dir === 'rtl';
        slider.scrollBy({ left: (rtl ? -dir : dir) * step, behavior: 'smooth' });
      };

      prev.addEventListener('click', () => scroll(-1));
      next.addEventListener('click', () => scroll(1));
    });
  }

  initSlider();
  document.addEventListener('astro:page-load', initSlider);
</script>

<style>
  /* ── Wrapper & horizontal scroll container ─────────────────── */
  .project-slider-wrapper {
    position: relative;
    width: 100%;
    margin: 50px 0 60px;
    
    /* Default Dark Mode Shadows */
    --shadow-card: 0 10px 30px rgba(0, 0, 0, 0.4);
    --shadow-card-hover: 0 25px 50px rgba(0, 0, 0, 0.6);
    --shadow-btn: 0 10px 25px rgba(0, 0, 0, 0.4);
    --shadow-btn-hover: 0 12px 30px rgba(var(--accent-a-rgb), 0.5);
  }

  :global(body.light) .project-slider-wrapper {
    /* Adaptive Light Mode Shadows */
    --shadow-card: 0 10px 30px rgba(7, 16, 38, 0.06);
    --shadow-card-hover: 0 25px 50px rgba(7, 16, 38, 0.12);
    --shadow-btn: 0 10px 25px rgba(7, 16, 38, 0.08);
    --shadow-btn-hover: 0 12px 30px rgba(var(--accent-a-rgb), 0.3);
  }

  .project-slider {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 24px;
    padding: 10px 10px 36px;
    margin-bottom: -36px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }

  .project-slider::-webkit-scrollbar { display: none; }

  /* ── Card Dimensions — Wide & Cinematic (Fluid Responsive) ── */
  .project-card-wrapper {
    width: 85vw;
    max-width: 440px;
    min-width: 280px;
    flex: 0 0 auto;
    scroll-snap-align: start;
    display: flex;
  }

  .project-card-wrapper > * { width: 100%; }

  /* ── Arrow navigation controls ─────────────────────────────── */
  .slider-controls {
    position: absolute;
    top: 50%;
    left: -20px;
    right: -20px;
    transform: translateY(-60%);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    z-index: 10;
  }

  .slider-btn {
    pointer-events: auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: var(--shadow-btn);
    font-size: 15px;
  }

  .slider-btn:hover {
    background: var(--accent-a);
    color: #fff;
    transform: scale(1.1);
    border-color: var(--accent-a);
    box-shadow: var(--shadow-btn-hover);
  }

  .slider-btn:focus-visible {
    outline: 2px solid var(--accent-a);
    outline-offset: 4px;
    background: var(--accent-a);
    color: #fff;
  }

  .slider-btn:active { transform: scale(0.95); }

  html[dir="rtl"] .prev-btn i,
  html[dir="rtl"] .next-btn i { transform: rotate(180deg); }

  /* ── Card shell ─────────────────────────────────────────────── */
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: calc(var(--radius) * 1.2);
    overflow: hidden;
    text-decoration: none !important;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }

  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 25px 50px rgba(0,0,0,0.3);
    border-color: rgba(var(--accent-a-rgb), 0.3);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--accent-a);
    outline-offset: 4px;
    border-color: var(--accent-a);
  }

  /* ── Image / Slideshow area ─────────────────────────────────── */
  .project-card-image {
    position: relative;
    height: 240px;
    background: linear-gradient(135deg,
      rgba(var(--surface-rgb), 0.95) 0%,
      rgba(var(--accent-b-rgb), 0.15) 100%);
    overflow: hidden;
    flex-shrink: 0;
  }

  .slide-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.9s ease-in-out;
    will-change: opacity;
    z-index: 0;
  }

  .slide-img.active {
    opacity: 0.85;
    z-index: 1;
  }

  .project-card:hover .slide-img.active {
    opacity: 1;
  }

  /* Gradient scrim at bottom of image */
  .img-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom,
      transparent 40%,
      rgba(var(--surface-rgb), 0.92) 100%);
    z-index: 2;
    pointer-events: none;
  }

  /* Category icon badge */
  .card-icon {
    position: absolute;
    top: 240px;
    transform: translateY(-50%);
    left: 20px;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid rgba(var(--accent-a-rgb), 0.35);
    color: var(--accent-a);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    z-index: 10;
    transition: all 0.3s ease;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  html[dir="rtl"] .card-icon { left: auto; right: 20px; }

  .project-card:hover .card-icon {
    background: var(--accent-a);
    transform: translateY(-50%) scale(1.08);
    color: #fff;
    border-color: var(--accent-a);
    box-shadow: 0 6px 15px rgba(var(--accent-a-rgb), 0.4);
  }

  /* Dot indicators */
  .slide-dots {
    position: absolute;
    bottom: 14px;
    right: 20px;
    display: flex;
    gap: 6px;
    z-index: 3;
  }

  html[dir="rtl"] .slide-dots { right: auto; left: 20px; }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--surface-alpha-85);
    border: 1px solid var(--border-subtle);
    transition: all 0.3s ease;
  }

  .dot.active {
    background: var(--accent-a);
    transform: scale(1.4);
    box-shadow: 0 0 8px var(--accent-a);
  }

  /* ── Text content ───────────────────────────────────────────── */
  .project-card-content {
    padding: 24px 24px 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 10px;
    text-align: left;
  }

  html[dir="rtl"] .project-card-content { text-align: right; }

  .project-badge {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text);
    background: rgba(var(--accent-a-rgb), 0.2);
    border: 1px solid var(--accent-a);
    padding: 3px 8px;
    border-radius: 6px;
    line-height: 1;
    align-self: flex-start;
  }

  .project-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* The punchy hook line — short, results-focused */
  .project-hook {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Card footer: Executive bar (tags + CTA) ────────────────── */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .tag {
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    background: var(--surface-alpha-65);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    color: var(--muted);
    white-space: nowrap;
  }

  .view-cta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    background: rgba(var(--accent-a-rgb), 0.25);
    border: 1px solid var(--accent-a);
    padding: 6px 12px;
    border-radius: 8px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.25s ease;
  }

  .project-card:hover .view-cta {
    background: var(--accent-a);
    color: #fff;
  }

  .view-cta i {
    font-size: 11px;
    transition: transform 0.25s var(--ease);
  }

  .project-card:hover .view-cta i { transform: translateX(4px); }
  html[dir="rtl"] .view-cta i { transform: rotate(180deg); }
  html[dir="rtl"] .project-card:hover .view-cta i { transform: rotate(180deg) translateX(4px); }

  /* ── Responsive Overrides ───────────────────────────────────── */

  /* Tablet (768px - 1024px) */
  @media (max-width: 1024px) {
    .project-card-image {
      height: 210px;
    }

    .project-title { font-size: 18px; }
    .project-hook { font-size: 13.5px; }
  }

  /* Mobile (< 768px) — Wide & Sleek */
  @media (max-width: 768px) {
    .project-slider {
      gap: 16px;
      padding: 10px 24px 36px;
    }

    .project-card-image {
      height: 185px;
    }

    .project-card-content {
      padding: 22px 20px 18px;
      gap: 12px;
    }

    .card-icon {
      top: 185px;
      bottom: auto;
      left: 16px;
      width: 36px;
      height: 36px;
      font-size: 16px;
    }
    html[dir="rtl"] .card-icon { left: auto; right: 16px; }

    .slide-dots {
      bottom: 12px;
      right: 16px;
    }
    html[dir="rtl"] .slide-dots { right: auto; left: 16px; }

    .project-title {
      font-size: 18px;
      font-weight: 700;
      line-height: 1.45;
    }

    .project-hook {
      font-size: 13.5px;
      -webkit-line-clamp: 3;
      line-height: 1.6;
    }

    /* Executive footer bar on mobile */
    .card-footer {
      padding-top: 12px;
      gap: 8px;
    }

    .tag {
      font-size: 10px;
      padding: 3px 8px;
    }

    /* Show CTA text on mobile now that card is wide! */
    .view-cta span { display: inline; font-size: 12px; }
    .view-cta i { font-size: 11px; }

    .slider-controls {
      display: none !important;
    }

    .slider-btn {
      width: 48px;
      height: 48px;
      font-size: 15px;
    }
  }

  /* Very small screens (< 360px) */
  @media (max-width: 360px) {
    .project-card-image { height: 165px; }
    .view-cta span { display: none; } /* Hide text only on tiny screens */
  }
</style>
