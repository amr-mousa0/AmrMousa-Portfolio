<div class="sticky-cta-mobile">
  <a href="#contact" class="sticky-btn contact-btn" aria-label="Contact Form">
    <i class="fa-solid fa-envelope text-lg"></i>
    <span data-i18n="nav_contact" class="font-poppins font-semibold">Contact</span>
  </a>
  <a href="https://wa.me/201017749925" target="_blank" rel="noopener noreferrer" class="sticky-btn whatsapp" aria-label="WhatsApp">
    <i class="fa-brands fa-whatsapp text-lg"></i>
    <span data-i18n="sticky_whatsapp" class="font-poppins font-semibold">WhatsApp</span>
  </a>
</div>

<style>
  .sticky-cta-mobile {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: var(--surface);
    border-top: 1px solid var(--border-subtle);
    z-index: 9000;
    padding: 12px 16px;
    gap: 12px;
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.5);
  }

  .sticky-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px; /* Touch target minimum */
    border-radius: 12px;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.3s var(--ease);
  }

  .sticky-btn:active {
    transform: scale(0.95);
  }

  .sticky-btn.contact-btn {
    background: var(--accent-a);
    color: white;
    box-shadow: 0 4px 15px rgba(var(--accent-a-rgb), 0.25);
  }

  .sticky-btn.whatsapp {
    background: var(--surface-alpha-85);
    color: var(--whatsapp-color);
    border: 1px solid rgba(var(--whatsapp-rgb), 0.3);
    box-shadow: 0 4px 15px rgba(var(--whatsapp-rgb), 0.15);
  }

  @media (max-width: 768px) {
    .sticky-cta-mobile {
      display: flex;
    }
    
    :global(body) {
      padding-bottom: 80px;
    }
  }
</style>
