---
export interface Props {
  gig: {
    id: string;
    icon?: string;
    tags?: string[];
  };
}

const { gig } = Astro.props;
---

<div class="gig-card card anim-child">
  <div class="gig-card-header">
    {gig.icon && (
      <div class="gig-icon">
        <i class={gig.icon}></i>
      </div>
    )}
    <h4 class="gig-title" data-i18n={`gig_${gig.id}_title`}>Loading...</h4>
  </div>
  
  <p class="gig-desc" data-i18n={`gig_${gig.id}_desc`}>Loading...</p>
  
  {gig.tags && gig.tags.length > 0 && (
    <div class="gig-tags">
      {gig.tags.map(tag => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}

  <button class="gig-action" onclick={`goToSection('#contact')`}>
    <span data-i18n="gig_cta">Inquire</span>
    <i class="fa-solid fa-arrow-right"></i>
  </button>
</div>

<style>
  .gig-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 24px;
    background: rgba(var(--surface-rgb), 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    transition: all 0.4s var(--ease);
    position: relative;
    overflow: hidden;
  }

  .gig-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at top right, rgba(var(--accent-a-rgb), 0.1), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
    z-index: 0;
    pointer-events: none;
  }

  .gig-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
    border-color: rgba(var(--accent-a-rgb), 0.3);
  }

  .gig-card:hover::before {
    opacity: 1;
  }

  .gig-card > * {
    position: relative;
    z-index: 1;
  }

  .gig-card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .gig-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(var(--accent-a-rgb), 0.1);
    color: var(--accent-a);
    font-size: 20px;
    flex-shrink: 0;
  }

  .gig-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
    margin: 0;
    line-height: 1.3;
  }

  .gig-desc {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 20px 0;
    flex-grow: 1;
  }

  .gig-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .tag {
    font-size: 11px;
    font-weight: 500;
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    color: var(--text);
  }

  .gig-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 12px 16px;
    background: transparent;
    border: 1px solid rgba(var(--accent-a-rgb), 0.3);
    border-radius: 8px;
    color: var(--accent-a);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s var(--ease);
  }

  .gig-action i {
    transition: transform 0.3s var(--ease);
  }

  .gig-action:hover {
    background: rgba(var(--accent-a-rgb), 0.1);
  }

  .gig-action:hover i {
    transform: translateX(4px);
  }
  
  html[dir="rtl"] .gig-action:hover i {
    transform: translateX(-4px);
  }
  
  html[dir="rtl"] .gig-action i {
    transform: rotate(180deg);
  }
  
  html[dir="rtl"] .gig-action:hover i {
    transform: rotate(180deg) translateX(4px);
  }
</style>
