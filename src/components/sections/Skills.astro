---
---

<section id="skills" aria-label="Technical Stack" class="skills-section">
  <div class="skills-glow-bg" aria-hidden="true"></div>
  <div class="skills-container">
    
    <!-- Section Sub-Header -->
    <div class="skills-section-header">
      <div class="skills-label-wrapper">
        <span class="skills-label-bar"></span>
        <span class="skills-label" data-i18n="nav_skills">Core Skills</span>
      </div>
      <h3 class="skills-heading font-poppins" data-i18n="skills_subtitle">Technical Expertise & Capabilities</h3>
    </div>

    <!-- Technical Stack Grid -->
    <div class="tools-grid">
      
      <!-- SQL Card -->
      <div class="tool-card sql-glow" tabindex="0">
        <div class="card-ambient-overlay"></div>
        <div class="tool-card-content">
          <div class="tool-icon">
