</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initSkillsAnimation() {
    const section = document.querySelector('.skills-section');
    if (!section) return;

    const header = section.querySelector('.skills-section-header');
    const cards = section.querySelectorAll('.tool-card');

    // Initial state
    gsap.set(header, { opacity: 0, y: 8 });
    gsap.set(cards, { opacity: 0, y: 8 });

    // Staggered reveal timeline (soft, lightweight, no scale, fast duration)
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        scroller: "main",
        start: "top 85%",
        toggleActions: "play none none none"
      }
    });

    tl.to(header, { opacity: 1, y: 0, duration: 0.4, ease: "power1.out" })
      .to(cards, { 
        opacity: 1, 
        y: 0, 
        stagger: 0.06, 
        duration: 0.4, 
        ease: "power1.out" 
      }, "-=0.2");
  }

  // Bootstrap
  initSkillsAnimation();
  document.addEventListener('astro:page-load', initSkillsAnimation);
</script>

<style>
  .skills-section {
    position: relative;
    padding: 80px 40px;
    background: var(--bg);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .skills-glow-bg {
    position: absolute;
    bottom: -10%;
    right: 10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(var(--accent-b-rgb), 0.02) 0%, rgba(0,0,0,0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .skills-container {
    width: 100%;
    max-width: 1300px;
    position: relative;
    z-index: 2;
  }

  .skills-section-header {
    margin-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .skills-label-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .skills-label-bar {
    width: 24px;
    height: 2px;
    background: var(--accent-b);
  }

  .skills-label {
    font-size: 13.5px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    color: var(--accent-b);
  }

  .skills-heading {
    font-size: 26px;
    font-weight: 700;
    color: var(--text);
  }

  /* Grid Layout */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    width: 100%;
  }

  /* Glass Cards */
  .tool-card {
    position: relative;
    background: var(--surface-card);
    border: 1px solid var(--border-card);
    border-radius: 16px;
    padding: 30px 24px;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.4s ease;
    overflow: hidden;
  }

  .tool-card-content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card-ambient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .tool-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 120px at var(--x, 50%) var(--y, 50%), rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 100%);
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 2;
    pointer-events: none;
  }

  .tool-card:hover::before,
  .tool-card:focus-visible::before {
    opacity: 1;
  }

  .tool-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.4s ease;
  }

  .tool-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
  }

  .tool-desc {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--muted);
    font-weight: 400;
  }

  /* Custom glow colors on hover */
  .tool-card:hover,
  .tool-card:focus-visible {
    transform: translateY(-6px);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .tool-card:hover .tool-icon {
    transform: scale(1.08) rotate(2deg);
  }

  /* SQL Glow (Cyan) */
  .tool-card.sql-glow:hover {
    box-shadow: 0 15px 30px rgba(0, 188, 242, 0.1);
    border-color: rgba(0, 188, 242, 0.3);
  }
  .tool-card.sql-glow:hover .tool-icon {
    background: rgba(0, 188, 242, 0.1);
  }

  /* Python Glow (Blue/Gold) */
  .tool-card.python-glow:hover {
    box-shadow: 0 15px 30px rgba(56, 126, 184, 0.12);
    border-color: rgba(56, 126, 184, 0.3);
  }
  .tool-card.python-glow:hover .tool-icon {
    background: rgba(56, 126, 184, 0.1);
  }

  /* Excel Glow (Green) */
  .tool-card.excel-glow:hover {
    box-shadow: 0 15px 30px rgba(16, 124, 65, 0.12);
    border-color: rgba(16, 124, 65, 0.3);
  }
  .tool-card.excel-glow:hover .tool-icon {
    background: rgba(16, 124, 65, 0.1);
  }

  /* Power BI Glow (Yellow/Gold) */
  .tool-card.powerbi-glow:hover {
    box-shadow: 0 15px 30px rgba(246, 215, 81, 0.1);
    border-color: rgba(246, 215, 81, 0.3);
  }
  .tool-card.powerbi-glow:hover .tool-icon {
    background: rgba(246, 215, 81, 0.1);
  }

  /* Interactive Hover Track Script (for CSS variable mapping) */
  @media (hover: hover) {
    .tool-card {
      pointer-events: auto;
    }
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .skills-section {
      min-height: auto !important;
      align-items: flex-start;
      padding: 24px 10px 28px !important;
      overflow-x: clip;
    }

    .skills-section-header {
      max-width: 100%;
      margin-bottom: 14px;
      gap: 5px;
      overflow: hidden;
    }

    .skills-label-wrapper {
      max-width: 100%;
      gap: 8px;
    }

    .skills-label-bar {
      flex: 0 0 18px;
      width: 18px;
    }

    .skills-label {
      font-size: 11px;
      letter-spacing: 0.13em;
    }

    .skills-heading {
      max-width: 100%;
      font-size: clamp(17px, 4.8vw, 20px);
      line-height: 1.18;
      overflow-wrap: anywhere;
      text-wrap: balance;
    }

    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    .tool-card {
      min-width: 0;
      padding: 14px 10px;
      border-radius: 13px;
      background: var(--surface-card);
    }

    .tool-card-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 8px;
    }

    .tool-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
    }

    .tool-icon svg {
      width: 24px;
      height: 24px;
    }

    .tool-name {
      font-size: 14px;
      font-weight: 700;
      line-height: 1.2;
    }

    .tool-desc {
      font-size: 10px;
      line-height: 1.32;
      color: var(--muted);
    }

    .tool-card:hover,
    .tool-card:focus-visible {
      transform: none;
    }
  }

  @media (max-width: 420px) {
    .skills-section {
      padding-inline: 6px !important;
    }

    .tools-grid {
      gap: 8px;
    }

    .tool-card {
      padding: 12px 8px;
    }

    .tool-desc {
      font-size: 9.5px;
    }
  }
</style>

<script is:inline>
  // Dynamic light track on mouse move for capabilities cards (Desktop hover only)
  if (window.matchMedia('(hover: hover)').matches) {
    document.querySelectorAll('.tool-card').forEach(card => {
      card.addEventListener('mousemove', e => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--x', `${x}px`);
        card.style.setProperty('--y', `${y}px`);
      });
    });
  }
</script>
