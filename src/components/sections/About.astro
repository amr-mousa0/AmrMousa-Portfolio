---
---

<section id="who" aria-labelledby="who-title" class="who-section" style="background: transparent !important;">
  <div class="who-glow-bg" aria-hidden="true"></div>
  <div class="who-container">
    <div class="who-grid">
      
      <!-- Left Column: Narrative Storytelling -->
      <div class="who-content">
        <div class="who-label-wrapper anim-child" style="transition-delay: 0.05s;">
          <span class="who-label-bar"></span>
          <h2 id="who-title" class="who-label" data-i18n="who_title">Who I am</h2>
        </div>
        <div class="who-heading font-poppins anim-child" style="transition-delay: 0.1s;">
          <span class="reveal-line" data-i18n="who_p1">I translate complex data into clear, actionable insights that drive smarter decision-making.</span>
        </div>
        <div class="who-narrative">
          <p class="reveal-p anim-child" style="transition-delay: 0.15s;" data-i18n="who_p2">My journey began in analytics and naturally evolved into a deep interest in human behavior—understanding not just the <em>what</em> of data, but the <em>why</em> behind every interaction.</p>
          <p class="reveal-p anim-child" style="transition-delay: 0.2s;" data-i18n="who_p3">I bridge the gap between technical performance and the human journey, turning patterns and conversions into a cohesive strategy.</p>
          <p class="reveal-p anim-child" style="transition-delay: 0.25s;" data-i18n="who_p4">I believe the most powerful solutions emerge at the intersection of data, strategy, and human understanding.</p>
          <p class="reveal-p anim-child" style="transition-delay: 0.3s;" data-i18n="who_p5">When faced with complexity, I focus on finding direction through structure, patterns, and purposeful insight.</p>
        </div>
      </div>

      <!-- Right Column: Interactive Cinematic Visual Canvas -->
      <div class="who-visual-column" aria-hidden="true">
        <div class="who-visual-canvas">
          <!-- Card 1: Data Analytics (Foreground) -->
          <div class="visual-card data-card anim-child" style="transition-delay: 0.35s; background: transparent !important; box-shadow: none !important; border: none !important;">
            <div class="card-chart-wrapper">
              <svg viewBox="0 0 100 40" class="mini-chart">
                <defs>
                  <linearGradient id="chart-glow" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--accent-a)" stop-opacity="0.4"></stop>
                    <stop offset="100%" stop-color="var(--accent-a)" stop-opacity="0"></stop>
                  </linearGradient>
                </defs>
                <path d="M0,35 Q15,10 30,25 T60,5 T90,20 L100,10 L100,40 L0,40 Z" fill="url(#chart-glow)"></path>
                <path d="M0,35 Q15,10 30,25 T60,5 T90,20 L100,10" fill="none" stroke="var(--accent-a)" stroke-width="2" stroke-linecap="round" class="chart-line-draw"></path>
                <circle cx="60" cy="5" r="3" fill="#fff" class="chart-pulse-node"></circle>
              </svg>
            </div>
            <div class="card-metrics">
              <div class="metric-row">
                <span class="metric-title">Performance Index</span>
                <span class="metric-val text-accent">+250%</span>
              </div>
              <div class="metric-bar-bg"><div class="metric-bar-fill fill-accent"></div></div>
            </div>
          </div>

          <!-- Card 2: Marketing Strategy (Background Depth) -->
          <div class="visual-card strategy-card anim-child" style="transition-delay: 0.4s; background: transparent !important; box-shadow: none !important; border: none !important;">
            <div class="card-metrics">
              <div class="metric-row">
                <span class="metric-title">Conversion Rate</span>
                <span class="metric-val text-secondary">92.4%</span>
              </div>
              <div class="metric-bar-bg"><div class="metric-bar-fill fill-secondary"></div></div>
            </div>
            <div class="connections-net">
              <svg viewBox="0 0 80 40" class="net-svg">
                <circle cx="15" cy="10" r="2" fill="var(--muted)"></circle>
                <circle cx="40" cy="20" r="2.5" fill="var(--accent-b)"></circle>
                <circle cx="65" cy="15" r="2" fill="var(--muted)"></circle>
                <circle cx="50" cy="32" r="1.5" fill="var(--muted)"></circle>
                <line x1="15" y1="10" x2="40" y2="20" stroke="var(--border-subtle)" stroke-width="0.75"></line>
                <line x1="40" y1="20" x2="65" y2="15" stroke="var(--border-subtle)" stroke-width="0.75"></line>
                <line x1="40" y1="20" x2="50" y2="32" stroke="var(--border-subtle)" stroke-width="0.75"></line>
                <line x1="15" y1="10" x2="50" y2="32" stroke="var(--border-subtle)" stroke-width="0.5" stroke-dasharray="2,2"></line>
              </svg>
            </div>
          </div>

          <!-- Decorative Ambient Glowing Circles -->
          <div class="ambient-glow orb-1"></div>
          <div class="ambient-glow orb-2"></div>
        </div>
      </div>

    </div>
  </div>
</section>



<style>
  .who-section {
    position: relative;
    padding: 100px 40px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .who-glow-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(var(--accent-a-rgb), 0.03) 0%, rgba(0,0,0,0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .who-container {
    width: 100%;
    max-width: 1300px;
    position: relative;
    z-index: 2;
  }

  .who-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 80px;
    align-items: center;
  }

  /* Left Column: Content Styling */
  .who-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 720px;
  }

  .who-label-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .who-label-bar {
    width: 24px;
    height: 2px;
    background: var(--accent-a);
    display: inline-block;
  }

  .who-label {
    font-size: 13.5px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    color: var(--accent-a);
  }

  .who-heading {
    font-size: 28px;
    line-height: 1.3;
    font-weight: 700;
    color: var(--text);
  }

  .who-narrative {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .who-narrative p {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--muted);
  }

  .who-narrative p em {
    color: var(--text);
    font-style: normal;
    font-weight: 500;
  }

  /* Right Column: Interactive Canvas */
  .who-visual-column {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    width: 100%;
    min-height: 400px;
  }

  .who-visual-canvas {
    position: relative;
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 40px;
  }

  .visual-card {
    position: relative;
    z-index: 5;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Foregound Data Card */
  .data-card {
    width: 280px;
    z-index: 10;
  }



  .card-chart-wrapper {
    width: 100%;
    margin-bottom: 16px;
  }

  .mini-chart {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .chart-pulse-node {
    filter: drop-shadow(0 0 4px var(--accent-a));
    /* Removed continuous animation for Lighthouse performance */
  }

  /* Background Strategy Card */
  .strategy-card {
    width: 280px;
    z-index: 6;
  }

  .connections-net {
    margin-top: 14px;
    width: 100%;
  }

  .net-svg {
    width: 100%;
    height: auto;
  }

  /* Metrics styling within cards */
  .card-metrics {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .metric-title {
    font-size: 11px;
    color: var(--muted);
    font-weight: 500;
  }

  .metric-val {
    font-size: 13px;
    font-weight: 700;
  }

  .metric-val.text-accent { color: var(--accent-a); }
  .metric-val.text-secondary { color: var(--accent-b); }

  .metric-bar-bg {
    width: 100%;
    height: 4px;
    background: var(--badge-bg);
    border-radius: 2px;
    overflow: hidden;
  }

  .metric-bar-fill {
    height: 100%;
    border-radius: 2px;
  }

  .metric-bar-fill.fill-accent {
    width: 75%;
    background: var(--accent-a);
  }

  .metric-bar-fill.fill-secondary {
    width: 92%;
    background: var(--accent-b);
  }

  /* Ambient glowing orbs */
  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.15;
    pointer-events: none;
  }

  .orb-1 {
    width: 150px;
    height: 150px;
    background: var(--accent-a);
    top: 20px;
    right: 40px;
  }

  .orb-2 {
    width: 130px;
    height: 130px;
    background: var(--accent-b);
    bottom: 20px;
    left: 40px;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .who-grid {
      gap: 40px;
    }
  }

  @media (max-width: 768px) {
    .who-section {
      padding: 60px 20px;
    }

    .who-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .who-content {
      gap: 12px;
    }

    .who-heading {
      font-size: 22px;
      line-height: 1.35;
    }

    .who-narrative {
      gap: 10px;
    }

    .who-narrative p {
      font-size: 14px;
      line-height: 1.5;
    }

    .who-visual-column {
      height: auto;
      margin-top: 10px;
      width: 100%;
    }

    .who-visual-canvas {
      max-width: 100%;
      height: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      position: relative;
      width: 100%;
    }

    .visual-card {
      position: relative;
      left: auto !important;
      right: auto !important;
      top: auto !important;
      bottom: auto !important;
      width: 100% !important;
      max-width: 100%;
      padding: 14px 0;
    }

    .mini-chart {
      margin-bottom: 10px;
    }



    .connections-net {
      margin-top: 8px;
    }

    .ambient-glow {
      display: none !important;
    }
  }
</style>
