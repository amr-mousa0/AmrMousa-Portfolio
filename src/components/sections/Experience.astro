<script>
  function initExperienceSection() {
    const section = document.querySelector('.experience-section');
    if (!section) return;

    const slider = section.querySelector('.experience-slider') as HTMLElement;
    const progressFill = section.querySelector('.timeline-progress-fill') as HTMLElement;
    const prevBtn = section.querySelector('.prev-btn');
    const nextBtn = section.querySelector('.next-btn');
    const stations = section.querySelectorAll('.mobile-timeline-station');

    // 1. Initialize mobile timeline accordion click handlers
    stations.forEach((station) => {
      const header = station.querySelector('.station-header') as HTMLElement;
      if (!header) return;

      // Prevent duplicate listener attachments due to dual boot cycles
      if (header.dataset.listenerAttached === 'true') return;
      header.dataset.listenerAttached = 'true';

      header.addEventListener('click', (e) => {
        e.preventDefault();
        const isActive = station.classList.contains('active');

        // Close all stations
        stations.forEach((s) => {
          s.classList.remove('active');
          const sHeader = s.querySelector('.station-header');
          if (sHeader) sHeader.setAttribute('aria-expanded', 'false');
        });

        // Open clicked station
        if (!isActive) {
          station.classList.add('active');
          header.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // 2. Expand first station by default on load
    if (stations.length > 0) {
      stations.forEach((station, index) => {
        const header = station.querySelector('.station-header');
        if (index === 0) {
          station.classList.add('active');
          if (header) header.setAttribute('aria-expanded', 'true');
        } else {
          station.classList.remove('active');
          if (header) header.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // 3. Desktop slider progress bar and scroll controls
    if (slider) {
      const updateProgress = () => {
        const scrollWidth = slider.scrollWidth - slider.clientWidth;
        if (scrollWidth <= 0) return;
        
        const scrollLeft = Math.abs(slider.scrollLeft);
        const progress = scrollLeft / scrollWidth;
        
        if (progressFill) {
          progressFill.style.transformOrigin = document.documentElement.dir === 'rtl' ? 'right center' : 'left center';
          progressFill.style.transition = 'transform 0.2s cubic-bezier(0.16, 1, 0.3, 1)';
          progressFill.style.transform = `scaleX(${progress})`;
        }
      };

      slider.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress, { passive: true });
      updateProgress();

      // Slider Controls Click Actions (Desktop only)
      const scrollAmount = (dir: number) => {
        const card = slider.querySelector('.experience-card-wrapper') as HTMLElement;
        const gap = parseInt(getComputedStyle(slider).gap) || 24;
        const step = card ? card.offsetWidth + gap : 420;
        const isRtl = document.documentElement.dir === 'rtl';

        slider.scrollBy({
          left: (isRtl ? -dir : dir) * step,
          behavior: 'auto'
        });
      };

      if (prevBtn) {
        prevBtn.addEventListener('click', () => scrollAmount(-1));
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', () => scrollAmount(1));
      }
    }
  }

  // Bootstrap scripts
  initExperienceSection();
  document.addEventListener('astro:page-load', () => {
    initExperienceSection();
  });
</script>

<style>
  .experience-section {
    position: relative;
    padding: 80px 40px;
    background: transparent !important;
    overflow: hidden;
  }

  .experience-glow {
    position: absolute;
    top: -20%;
    left: 20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(var(--accent-a-rgb), 0.02) 0%, rgba(0,0,0,0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .experience-container {
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* Section Header styling */
  .experience-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 30px;
  }

  .header-titles {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
  }

  html[dir="rtl"] .header-titles {
    text-align: right;
  }

  .exp-label-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .exp-label-bar {
    width: 24px;
    height: 2px;
    background: var(--accent-a);
  }

  .exp-label {
    font-size: 13.5px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    color: var(--accent-a);
  }

  .exp-heading {
    font-size: 26px;
    font-weight: 700;
    color: var(--text);
  }

  /* Slider Controls styling */
  .slider-controls {
    display: flex;
    gap: 12px;
    z-index: 10;
  }

  .slider-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface-card);
    border: 1px solid var(--border-card);
    backdrop-filter: blur(10px);
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 14px;
  }

  .slider-btn:hover,
  .slider-btn:focus-visible {
    background: var(--accent-a);
    color: #fff;
    border-color: var(--accent-a);
    box-shadow: 0 0 20px rgba(var(--accent-a-rgb), 0.3);
  }

  .slider-btn:active {
    transform: scale(0.95);
  }

  html[dir="rtl"] .prev-btn i,
  html[dir="rtl"] .next-btn i {
    transform: rotate(180deg);
  }

  /* Timeline Progress Line Fill */
  .timeline-progress-wrapper {
    position: relative;
    width: 100%;
    height: 2px;
    margin-bottom: 40px;
  }

  .timeline-progress-track {
    width: 100%;
    height: 100%;
    background: var(--badge-bg);
    position: relative;
    border-radius: 2px;
  }

  .timeline-progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--accent-a), var(--accent-b));
    transform: scaleX(0);
    transform-origin: left center;
    border-radius: 2px;
  }

  html[dir="rtl"] .timeline-progress-fill {
    transform-origin: right center;
  }

  /* Slider Container styling */
  .experience-slider-wrapper {
    position: relative;
    width: 100%;
  }

  .experience-slider {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 24px;
    padding: 10px 4px 30px;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE10+ */
    -webkit-overflow-scrolling: touch;
  }

  .experience-slider::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  /* Card wrappers & items */
  .experience-card-wrapper {
    flex-shrink: 0;
    width: 520px; /* Widened slightly as per feedback */
    scroll-snap-align: start;
  }

  .experience-card {
    position: relative;
    background: var(--surface-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-card);
    border-radius: 20px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 310px;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12) !important;
  }

  .card-glass-glow {
    display: none;
  }

  .experience-card {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .experience-card:hover,
  .experience-card:focus-visible {
    border-color: var(--border-card-hover);
    background: var(--surface-card-hover);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
    transform: translateY(-8px);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    z-index: 2;
  }

  .exp-date-chip {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--muted);
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
    padding: 6px 12px;
    border-radius: 50px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: #27c93f;
    border-radius: 50%;
    position: relative;
    display: inline-block;
  }

