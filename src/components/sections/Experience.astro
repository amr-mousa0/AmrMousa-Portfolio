---
---

<section id="experience" aria-labelledby="experience-title" class="experience-section">
  <div class="experience-glow" aria-hidden="true"></div>
  <div class="experience-container">
    
    <!-- Section Header -->
    <div class="experience-header anim-child" style="transition-delay: 0.05s;">
      <div class="header-titles">
        <div class="exp-label-wrapper">
          <span class="exp-label-bar"></span>
          <span class="exp-label" data-i18n="nav_experience">Experience</span>
        </div>
        <h2 id="experience-title" class="exp-heading font-poppins" data-i18n="experience_subtitle">Professional Career Timeline</h2>
      </div>
      
      <!-- Slider Navigation Controls -->
      <div class="slider-controls font-poppins">
        <button class="slider-btn prev-btn" aria-label="Previous experience">
          <i class="fa-solid fa-arrow-left"></i>
        </button>
        <button class="slider-btn next-btn" aria-label="Next experience">
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>

    <!-- Active Timeline Progress Indicator -->
    <div class="timeline-progress-wrapper" aria-hidden="true">
      <div class="timeline-progress-track">
        <div class="timeline-progress-fill"></div>
      </div>
    </div>

    <!-- Horizontal Carousel Slider -->
    <div class="experience-slider-wrapper">
      <div class="experience-slider">
        
        <!-- Card 1: NTI -->
        <div class="experience-card-wrapper anim-child" style="transition-delay: 0.1s;">
          <div class="experience-card" tabindex="0">
            <div class="card-glass-glow"></div>
            <div class="card-meta">
              <span class="exp-date-chip" data-i18n="exp_intern_date">Feb 2026 – present <span class="pulse-dot"></span></span>
              <span class="company-badge text-accent" data-i18n="exp_intern_company">National Telecommunication Institute - NTI</span>
            </div>
            <h4 class="exp-role-title" data-i18n="exp_intern_title">Data Analyst Intern</h4>
            <ul class="exp-bullet-list">
              <li data-i18n="exp_intern_bullet1">Completed a 120-hour intensive program focused on business intelligence and advanced analytics.</li>
              <li data-i18n="exp_intern_bullet2">Delivered 3+ end-to-end analytical projects, transforming raw data into strategic insights using SQL, Python, Power BI, and Excel.</li>
              <li data-i18n="exp_intern_bullet3">Collaborated with cross-functional teams to refine analytical models and present high-impact technical findings.</li>
              <li data-i18n="exp_intern_bullet4">Bridged technical analysis and business logic, providing actionable recommendations for data-driven decisions.</li>
            </ul>
          </div>
        </div>

        <!-- Card 2: So Care -->
        <div class="experience-card-wrapper anim-child" style="transition-delay: 0.16s;">
