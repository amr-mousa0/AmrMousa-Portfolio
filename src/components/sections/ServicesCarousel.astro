---
import { Image } from 'astro:assets';
import servicesData from '../../data/services.json';

import dataAnalyticsImg from '../../assets/services/data-analytics.jpg';
import mediaBuyingImg from '../../assets/services/media-buying.jpg';
import customCrmImg from '../../assets/services/custom-crm.jpg';
import excelExpertImg from '../../assets/services/Excel-Analysis.png';

const serviceImages = {
  'data-analytics': dataAnalyticsImg,
  'media-buying': mediaBuyingImg,
  'web-portfolios': null,
  'excel-expert': excelExpertImg,
  'crm-management': customCrmImg
};

const getServiceImg = (id: string) => (serviceImages as Record<string, any>)[id];
---

<section id="services" aria-labelledby="services-title" class="py-16 px-4 my-12 overflow-hidden relative">
  <!-- Clean, high-performance container (no massive GPU blur filters) -->

  <div class="max-w-7xl mx-auto relative z-10">
    
    <!-- Section Header -->
    <div class="services-section-header anim-child mb-10">
      <div class="header-titles font-poppins">
        <h2 id="services-title" class="text-3xl md:text-4xl font-bold text-text-main mb-3 tracking-tight" data-i18n="services_title">Services & Gigs</h2>
        <p class="text-sm md:text-base text-muted max-w-xl font-poppins" data-i18n="services_subtitle">Actionable solutions designed to solve bottlenecks, eliminate wasted spend, and drive measurable growth.</p>
      </div>
    </div>

    <!-- Premium Compact Services Slider (Cloned from Projects Slider layout) -->
    <div class="services-slider-wrapper anim-child">
      
      <!-- Floating Navigation Controls (< and > circular buttons on the block itself) -->
      <div class="slider-controls font-poppins">
        <button class="slider-btn prev-btn" aria-label="Previous service">
          <i class="fa-solid fa-chevron-left font-normal"></i>
        </button>
        <button class="slider-btn next-btn" aria-label="Next service">
          <i class="fa-solid fa-chevron-right font-normal"></i>
        </button>
      </div>

      <div class="services-slider scrolling-wrapper">
        {servicesData.map((service) => {
          const serviceImg = getServiceImg(service.id);
          return (
            <article class="service-card-wrapper">
              <a href={`${import.meta.env.BASE_URL}services/${service.id}`} onclick={`trackClick('service_click', { service_id: '${service.id}' })`} class="service-card font-poppins" aria-label={`View ${service.title} details`}>

                <!-- ── Clean Illustration & Icon Banner ── -->
                <div class="luxury-card-banner">
                  {serviceImg ? (
                    <Image 
                      src={serviceImg} 
                      alt={service.title} 
                      width={320} 
                      height={140} 
                      quality={88} 
                      format="webp" 
                      class="service-banner-img" 
                    />
                  ) : (
                    <div class="banner-icon-wrap">
                      <i class={service.icon}></i>
                    </div>
                  )}
                  <span class="service-clean-badge" data-i18n="service_badge">SERVICE</span>
                  <span class="status-dot"></span>
                </div>

                <!-- ── Text Content ── -->
                <div class="service-card-content font-poppins">
                  <h3 class="service-title font-poppins" data-i18n={`service_${service.id}_title`}>{service.title}</h3>
                  <p class="service-hook font-poppins" data-i18n={`service_${service.id}_copy`}>{service.copy}</p>
                  <div class="card-footer font-poppins">
                    <span class="explore-hint font-poppins">
                      <span data-i18n="service_explore">Explore Details</span>
                      <i class="fa-solid fa-arrow-right"></i>
                    </span>
                  </div>
                </div>

              </a>
            </article>
          );
        })}
      </div>
    </div>

  </div>
</section>

<script>
  // ── Horizontal card slider with Floating Controls ─────────────
  function initServicesSlider() {
    document.querySelectorAll('#services').forEach(section => {
      const slider = section.querySelector('.services-slider') as HTMLElement;
      const prev   = section.querySelector('.prev-btn');
      const next   = section.querySelector('.next-btn');
      if (!slider || !prev || !next) return;

      const scroll = (dir: number) => {
        const card = slider.querySelector('.service-card-wrapper') as HTMLElement;
        const gap  = parseInt(getComputedStyle(slider).gap) || 20;
        const step = card ? card.offsetWidth + gap : 290;
        const rtl  = document.documentElement.dir === 'rtl';
        slider.scrollBy({ left: (rtl ? -dir : dir) * step, behavior: 'smooth' });
      };

      prev.addEventListener('click', () => scroll(-1));
      next.addEventListener('click', () => scroll(1));
    });
  }

  // Bootstrap immediately and on Astro view-transitions
  initServicesSlider();
  document.addEventListener('astro:page-load', initServicesSlider);
</script>

<style>
  /* ── Section Header ── */
  .services-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 24px;
  }

  .header-titles {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  html[dir="rtl"] .header-titles { text-align: right; }

  /* ── Wrapper & horizontal scroll container ─────────────────── */
  .services-slider-wrapper {
    position: relative;
    width: 100%;
    margin: 30px 0 40px;
  }

  .services-slider {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 20px;
    padding: 10px 10px 40px;
    margin-bottom: -40px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }

  .services-slider::-webkit-scrollbar { display: none; }

  /* ── Floating Arrow Controls (Cloned from Projects Slider) ── */
  .slider-controls {
    position: absolute;
    top: 50%;
    left: -20px;
    right: -20px;
    transform: translateY(-60%);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    z-index: 10;
  }

  .slider-btn {
    pointer-events: auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    font-size: 15px;
  }

  .slider-btn:hover {
    background: var(--accent-a);
    color: #fff;
    transform: scale(1.1);
    border-color: var(--accent-a);
    box-shadow: 0 12px 30px rgba(var(--accent-a-rgb), 0.5);
  }

  .slider-btn:focus-visible {
    outline: 2px solid var(--accent-a);
    outline-offset: 4px;
    background: var(--accent-a);
    color: #fff;
  }

  .slider-btn:active { transform: scale(0.95); }

  html[dir="rtl"] .prev-btn i,
  html[dir="rtl"] .next-btn i { transform: rotate(180deg); }

  /* ── Card Dimensions — Optimal Luxury Proportions (Fluid Responsive) ── */
  .service-card-wrapper {
    width: 92vw;
    max-width: 400px;
    min-width: 280px;
    flex: 0 0 auto;
    scroll-snap-align: start;
    display: flex;
  }

  .service-card-wrapper > * { width: 100%; }

  /* ── Bento Box Grid for Desktop (Removes horizontal slider) ── */
  @media (min-width: 992px) {
    .services-slider {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: minmax(280px, auto);
      gap: 30px;
      overflow-x: visible;
      padding: 0;
      margin-bottom: 0;
    }
    .service-card-wrapper {
      width: 100% !important;
      max-width: none !important;
      min-width: 0 !important;
    }
    .service-card-wrapper:nth-child(1) {
      grid-column: span 2;
    }
    .service-card-wrapper:nth-child(1) .luxury-card-banner {
      height: 160px;
    }
    .slider-controls {
      display: none !important;
    }
  }

  /* ── Card Shell (Entirely Clickable) ─────────────────── */
  .service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface-card);
    border: 1px solid var(--border-card);
    border-radius: calc(var(--radius) * 1.2);
    overflow: hidden;
    text-decoration: none !important;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .service-card:hover {
    transform: translateY(-6px);
    background: var(--surface-card-hover);
    border-color: var(--border-card-hover);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.2);
  }

  .service-card:focus-visible {
    outline: 2px solid var(--accent-a);
    outline-offset: 4px;
    border-color: var(--accent-a);
  }

  .service-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .service-card:hover .service-banner-img {
    transform: scale(1.05);
  }

  /* ── Clean Card Banner — matches site design system ─────── */
  .luxury-card-banner {
    position: relative;
    height: 200px;
    background: var(--surface-card);
    border-bottom: 1px solid var(--border-card);
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Very subtle warm accent wash — not blue, just a glow */
  .luxury-card-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 60% at 50% 60%,
      rgba(var(--accent-a-rgb), 0.07) 0%,
      transparent 80%
    );
    pointer-events: none;
  }

  /* Subtle grid texture */
  .luxury-card-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(var(--accent-a-rgb), 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--accent-a-rgb), 0.04) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }

  /* Large centered icon — clean, no aggressive blue square */
  .banner-icon-wrap {
    position: relative;
    z-index: 2;
    width: 68px;
    height: 68px;
    border-radius: 18px;
    background: rgba(var(--accent-a-rgb), 0.1);
    border: 1px solid rgba(var(--accent-a-rgb), 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    color: var(--accent-a);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .service-card:hover .banner-icon-wrap {
    background: rgba(var(--accent-a-rgb), 0.18);
    border-color: rgba(var(--accent-a-rgb), 0.4);
    transform: scale(1.06);
    box-shadow: 0 8px 28px rgba(var(--accent-a-rgb), 0.22);
  }

  /* SERVICE badge — top-left, very subtle */
  .service-clean-badge {
    position: absolute;
    top: 12px;
    left: 14px;
    z-index: 3;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
    padding: 3px 8px;
    border-radius: 5px;
    line-height: 1;
  }

  html[dir="rtl"] .service-clean-badge { left: auto; right: 14px; }

  /* Static dot — no continuous animation (Lighthouse: avoid non-composited anims) */
  .status-dot {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 3;
    width: 7px;
    height: 7px;
    background: var(--accent-a);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent-a);
  }

  html[dir="rtl"] .status-dot { right: auto; left: 14px; }

  /* ── Light mode: explicit white card ──────────────────── */
  :global(body.light) .service-card {
    background: #ffffff;
    border-color: rgba(7, 16, 38, 0.1);
    box-shadow: 0 4px 20px rgba(7, 16, 38, 0.06);
  }

  :global(body.light) .service-card:hover {
    background: #ffffff;
    border-color: rgba(7, 16, 38, 0.18);
    box-shadow: 0 12px 36px rgba(7, 16, 38, 0.1);
  }

  :global(body.light) .luxury-card-banner {
    background: #f5f7fa;
    border-bottom-color: rgba(7, 16, 38, 0.08);
  }

  :global(body.light) .service-clean-badge {
    background: rgba(7, 16, 38, 0.05);
    border-color: rgba(7, 16, 38, 0.12);
    color: rgba(7, 16, 38, 0.5);
  }

  :global(body.light) .service-hook {
    color: #475569;
  }

  :global(body.light) .service-title {
    color: #071026;
  }

  :global(body.light) .explore-hint {
    color: var(--light-accent-a);
    border-color: rgba(11, 132, 255, 0.3);
    background: rgba(11, 132, 255, 0.06);
  }

  :global(body.light) .card-footer {
    border-top-color: rgba(7, 16, 38, 0.08);
  }

  .banner-center-icon {
    position: relative;
    z-index: 3;
    align-self: center;
    font-size: 32px;
    color: var(--accent-a);
    filter: drop-shadow(0 4px 15px rgba(var(--accent-a-rgb), 0.4));
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    margin-bottom: 2px;
  }

  .service-card:hover .banner-center-icon {
    transform: scale(1.18) rotate(8deg);
    filter: drop-shadow(0 6px 20px rgba(var(--accent-a-rgb), 0.7));
  }

  .banner-glass-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 50%);
    pointer-events: none;
    z-index: 2;
  }

  /* ── Expanded Text Content (Full Persuasive Copy) ───────────── */
  .service-card-content {
    padding: 20px 20px 18px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-align: left;
  }

  html[dir="rtl"] .service-card-content { text-align: right; }

  .service-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.35;
    margin: 0 0 12px 0;
  }

  .service-hook {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 16px 0;
    flex-grow: 1;
  }

  /* ── Subtle Explore Hint (Replaces bulky button) ────────────── */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }

  html[dir="rtl"] .card-footer { justify-content: flex-end; }

  .explore-hint {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    background: rgba(var(--accent-a-rgb), 0.25);
    border: 1px solid var(--accent-a);
    padding: 6px 12px;
    border-radius: 8px;
    white-space: nowrap;
    transition: all 0.25s ease;
  }

  .service-card:hover .explore-hint {
    background: var(--accent-a);
    color: #fff;
    gap: 8px;
  }

  .explore-hint i {
    font-size: 11px;
    transition: transform 0.25s var(--ease);
  }

  .service-card:hover .explore-hint i { transform: translateX(4px); }
  
  html[dir="rtl"] .explore-hint i { transform: rotate(180deg); }
  html[dir="rtl"] .service-card:hover .explore-hint i { transform: rotate(180deg) translateX(4px); }

  /* ── Responsive Overrides ───────────────────────────────────── */

  /* Tablet (768px - 1024px) */
  @media (max-width: 1024px) {
    .luxury-card-banner { height: 100px; padding: 12px 18px; }
    .banner-center-icon { font-size: 28px; }
    .service-title { font-size: 17px; }
    .service-hook { font-size: 13px; margin-bottom: 14px; }
    .service-card-content { padding: 18px 18px 16px; }
  }

  /* Mobile (max-width: 767px) */
  @media (max-width: 768px) {
    section#services {
      padding-top: 20px !important;
      padding-bottom: 40px !important;
      margin-top: 0px !important;
      margin-bottom: 10px !important;
    }

    .services-section-header {
      padding-bottom: 20px;
    }

    .services-slider {
      gap: 16px;
      padding-bottom: 24px;
      margin-bottom: -24px;
    }

    .luxury-card-banner {
      height: 95px;
      padding: 12px 16px;
    }

    .banner-center-icon { font-size: 26px; margin-bottom: 0; }
    .service-card-content { padding: 16px 16px 14px; }
    .service-title { font-size: 18px; margin-bottom: 8px; }
    .service-hook { font-size: 15px; line-height: 1.6; margin-bottom: 12px; }
    .card-footer { padding-top: 12px; }

    .slider-controls {
      display: none !important;
    }

    .slider-btn {
      width: 48px;
      height: 48px;
      font-size: 15px;
    }
  }

  /* Very small screens (< 360px) */
  @media (max-width: 360px) {
    .luxury-card-banner { height: 85px; }
    .explore-hint span { display: none; } /* Hide text only on tiny screens */
  }
</style>
