---
---
<section id="trust-bar" aria-label="Client Success Metrics" class="py-10 md:py-20 px-4 my-6 md:my-12 relative overflow-hidden">
  
  <!-- Architectural subtle background glow (no heavy GPU blurs, just clean radial opacity) -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(var(--accent-a-rgb),0.08)_0,transparent_70%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    
    <!-- ── DESKTOP & TABLET LAYOUT (100% Original, Untouched) ── -->
    <div class="desktop-only">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <div class="inline-block px-4 py-1.5 bg-surface-card border border-border-card rounded-full text-xs font-semibold text-accent-a uppercase tracking-widest mb-4 font-poppins backdrop-blur-md shadow-sm">
          <span data-i18n="trust_badge">Proven Track Record</span>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-playfair font-bold text-text-main tracking-tight" data-i18n="trust_headline">Measurable Impact & Scaling Authority</h2>
      </div>

      <!-- Harmonious 'Quiet Luxury' 3-Column Lockup -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        
        <!-- Metric 1: ROI Growth -->
        <div class="relative bg-surface-card border border-border-card rounded-2xl p-8 md:p-10 flex flex-col justify-between transition-all duration-500 hover:bg-surface-card-hover hover:border-border-card-hover shadow-luxury group">
          <div class="space-y-4">
            <div class="text-5xl md:text-6xl font-light text-text-main font-poppins tracking-tight group-hover:-translate-y-1 transition-transform duration-500" dir="ltr" data-i18n="trust_metric1_val"><bdi>+250%</bdi></div>
            <h3 class="text-lg md:text-xl font-semibold text-text-main tracking-wide font-poppins" data-i18n="trust_metric1_title">Average ROI Growth</h3>
          </div>
          <p class="text-sm text-muted leading-relaxed pt-6 border-t border-divider-line font-poppins mt-6 text-balance" data-i18n="trust_metric1_desc">Proven returns across e-commerce & B2B campaigns</p>
        </div>

        <!-- Metric 2: Revenue Generated -->
        <div class="relative bg-surface-card border border-border-card rounded-2xl p-8 md:p-10 flex flex-col justify-between transition-all duration-500 hover:bg-surface-card-hover hover:border-border-card-hover shadow-luxury group">
          <div class="space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-badge-bg border border-badge-border rounded-lg text-xs font-medium text-muted uppercase tracking-wider font-poppins">
              <i class="fa-solid fa-chart-line text-accent-a"></i>
              <span>Core Milestone</span>
            </div>
            <div class="text-5xl md:text-6xl font-light text-text-main font-poppins tracking-tight group-hover:-translate-y-1 transition-transform duration-500" dir="ltr" data-i18n="trust_metric2_val"><bdi>$85K+</bdi></div>
            <h3 class="text-lg md:text-xl font-semibold text-text-main tracking-wide font-poppins" data-i18n="trust_metric2_title">Revenue Generated</h3>
          </div>
          <p class="text-sm text-muted leading-relaxed pt-6 border-t border-divider-line font-poppins mt-6 text-balance" data-i18n="trust_metric2_desc">Direct impact from BI optimization & media buying</p>
        </div>

        <!-- Metric 3: Hours Saved -->
        <div class="relative bg-surface-card border border-border-card rounded-2xl p-8 md:p-10 flex flex-col justify-between transition-all duration-500 hover:bg-surface-card-hover hover:border-border-card-hover shadow-luxury group">
          <div class="space-y-4">
            <div class="text-5xl md:text-6xl font-light text-text-main font-poppins tracking-tight group-hover:-translate-y-1 transition-transform duration-500" dir="ltr" data-i18n="trust_metric3_val"><bdi>10+ Hrs</bdi></div>
            <h3 class="text-lg md:text-xl font-semibold text-text-main tracking-wide font-poppins" data-i18n="trust_metric3_title">Weekly Hours Saved</h3>
          </div>
          <p class="text-sm text-muted leading-relaxed pt-6 border-t border-divider-line font-poppins mt-6 text-balance" data-i18n="trust_metric3_desc">Replacing manual tasks with automated CRM workflows</p>
        </div>

      </div>
    </div>

    <!-- ── MOBILE-ONLY LAYOUT (Compact, Space-Saving, Colored & Beautiful) ── -->
    <div class="mobile-only">
      <!-- Section Header -->
      <div class="text-center mb-6">
        <div class="inline-block px-3 py-1 bg-surface-card border border-border-card rounded-full text-[9px] font-semibold text-accent-a uppercase tracking-widest mb-2 font-poppins">
          <span data-i18n="trust_badge">Proven Track Record</span>
        </div>
        <h2 class="text-lg font-bold text-text-main tracking-tight px-2" data-i18n="trust_headline">Measurable Impact & Scaling Authority</h2>
      </div>

      <!-- 3 Small side-by-side cards with luxury color styling -->
      <div class="grid grid-cols-3 gap-2 px-1">
        
        <!-- Card 1: Teal Glow -->
        <div class="relative bg-gradient-to-b from-[rgba(var(--accent-a-rgb),0.15)] to-[rgba(var(--accent-a-rgb),0.02)] border border-[rgba(var(--accent-a-rgb),0.3)] rounded-xl p-3 flex flex-col justify-between items-center text-center shadow-lg min-h-[105px]">
          <div class="absolute -top-[1px] left-1/2 -translate-x-1/2 w-8 h-[2px] bg-accent-a blur-[0.5px]"></div>
          <div class="text-xl sm:text-2xl font-bold text-accent-a font-poppins tracking-tight mt-1" dir="ltr" data-i18n="trust_metric1_val"><bdi>+250%</bdi></div>
          <h3 class="text-[9px] sm:text-[10px] font-semibold text-text-main tracking-tight font-poppins leading-tight mb-1" data-i18n="trust_metric1_title">Average ROI Growth</h3>
        </div>

        <!-- Card 2: Maroon Glow -->
        <div class="relative bg-gradient-to-b from-[rgba(var(--accent-b-rgb),0.15)] to-[rgba(var(--accent-b-rgb),0.02)] border border-[rgba(var(--accent-b-rgb),0.3)] rounded-xl p-3 flex flex-col justify-between items-center text-center shadow-lg min-h-[105px]">
          <div class="absolute -top-[1px] left-1/2 -translate-x-1/2 w-8 h-[2px] bg-accent-b blur-[0.5px]"></div>
          <div class="text-xl sm:text-2xl font-bold text-accent-b font-poppins tracking-tight mt-1" dir="ltr" data-i18n="trust_metric2_val"><bdi>$85K+</bdi></div>
          <h3 class="text-[9px] sm:text-[10px] font-semibold text-text-main tracking-tight font-poppins leading-tight mb-1" data-i18n="trust_metric2_title">Revenue Generated</h3>
        </div>

        <!-- Card 3: Dual Accent Glow -->
        <div class="relative bg-gradient-to-b from-[rgba(var(--accent-a-rgb),0.08)] to-[rgba(var(--accent-b-rgb),0.08)] border border-border-card rounded-xl p-3 flex flex-col justify-between items-center text-center shadow-lg min-h-[105px]">
          <div class="absolute -top-[1px] left-1/2 -translate-x-1/2 w-8 h-[2px] bg-gradient-to-r from-accent-a to-accent-b blur-[0.5px]"></div>
          <div class="text-xl sm:text-2xl font-bold text-text-main font-poppins tracking-tight mt-1" dir="ltr" data-i18n="trust_metric3_val"><bdi>10+ Hrs</bdi></div>
          <h3 class="text-[9px] sm:text-[10px] font-semibold text-text-main tracking-tight font-poppins leading-tight mb-1" data-i18n="trust_metric3_title">Weekly Hours Saved</h3>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  /* Base mobile styles */
  .desktop-only {
    display: none;
  }
  .mobile-only {
    display: block;
  }

  /* Desktop and Tablet styles (>= 768px) */
  @media (min-width: 768px) {
    .desktop-only {
      display: block;
    }
    .mobile-only {
      display: none;
    }
  }

  /* Mobile-specific Section Padding and Margin Override */
  @media (max-width: 767px) {
    section#trust-bar {
      padding: 24px 16px 0px !important;
      margin-top: 10px !important;
      margin-bottom: 10px !important;
    }
  }
</style>
