---
import Layout from '../../layouts/Layout.astro';
import { ContentHubClient } from '../../lib/content-hub/contentHubClient';
import { Image } from 'astro:assets';
import fallbackImg from '../../assets/projects/coffee.jpg';

// Generate static paths for SSG using Content Hub Gateway Client
export async function getStaticPaths() {
  const { projects } = await ContentHubClient.getProjects('portfolio', 'en');

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: any;
}

const { project } = Astro.props;
const cleanId = project.id.split('-')[0];

// Dynamically discover all images in the projects directory at build-time
const allImages = import.meta.glob('../../assets/projects/*.{png,jpg,jpeg,svg,webp}', { eager: true });
const allProjectImages = import.meta.glob('../../assets/images/**/*.{png,jpg,jpeg,svg,webp,PNG,JPG,JPEG,SVG,WEBP}', { eager: true });

function resolveAsset(url: string) {
  if (!url) return fallbackImg;
  if (typeof url === 'string' && (url.startsWith('http://') || url.startsWith('https://'))) {
    return url;
  }
  const decoded = decodeURIComponent(url);
  const relativePath = decoded.replace('/images/', '../../assets/images/');
  const matched = allProjectImages[relativePath] as any;
  return matched ? matched.default : fallbackImg;
}

const matchedAsset = project.imagePath ? allImages[project.imagePath] as any : null;
const localImgAsset = matchedAsset ? matchedAsset.default : fallbackImg;
const rawCover = project.image || (project as any).cover || (project.images && project.images.length > 0 ? project.images[0] : project.imagePath);
const imgAsset = rawCover ? resolveAsset(rawCover) : localImgAsset;

const currentLocale = Astro.currentLocale || 'en';
const displayTitle = currentLocale === 'ar' ? (project.titleAr || project.title) : (project.titleEn || project.title);
const displayDesc = currentLocale === 'ar' ? (project.descriptionAr || project.description) : (project.descriptionEn || project.description);
const displayProblem = currentLocale === 'ar' ? (project.problemAr || project.problem) : (project.problemEn || project.problem);
const displaySalesDesc = currentLocale === 'ar' ? (project.salesDescriptionAr || project.salesDescription) : (project.salesDescriptionEn || project.salesDescription);
const displayMetrics = currentLocale === 'ar' ? (project.salesFunnelMetricsAr || project.salesFunnelMetrics) : (project.salesFunnelMetricsEn || project.salesFunnelMetrics);
---

<Layout 
  title={`${project.title} — Amr Mousa Portfolio`}
  description={project.description}
  githubUrl={project.githubUrl}
  isProjectPage={true}
>
  <div class="project-details-page-container">
    
    <!-- Header Section -->
    <header class="project-details-header anim-child">
      <div class="project-header-badge">
        <span class="badge-dot"></span>
        <span data-i18n={`project_${cleanId}_category`}>{project.category}</span>
      </div>
      <h1 
        class="project-details-title" 
        data-title-en={project.titleEn || project.title} 
        data-title-ar={project.titleAr || project.title} 
        data-i18n={`project_${cleanId}_title`}
      >
        {displayTitle}
      </h1>
      
      <div class="project-details-tech-stack">
        {(project.tech || project.tags || []).map((t: string) => (
          <span class="tech-tag">{t}</span>
        ))}
      </div>
    </header>

    <!-- Main Content Layout -->
    <div class="project-details-grid">
      
      <!-- Left Column: Problem, Solution, Funnel metrics -->
      <div class="project-details-content-col anim-child">
        
        <!-- Problem Card -->
        <div class="details-card glass-card">
          <div class="card-icon-header">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <h2 data-i18n="project_problem_label">The Problem</h2>
          </div>
          <p 
            class="details-card-text" 
            data-problem-en={project.problemEn || project.problem} 
            data-problem-ar={project.problemAr || project.problem} 
            data-i18n={`project_${cleanId}_problem`}
          >
            {displayProblem}
          </p>
        </div>

        <!-- Solution Card -->
        <div class="details-card glass-card">
          <div class="card-icon-header">
            <i class="fa-solid fa-lightbulb"></i>
            <h2 data-i18n="project_solution_label">The Solution & Value</h2>
          </div>
          <p 
            class="details-card-text" 
            data-solution-en={project.salesDescriptionEn || project.salesDescription} 
            data-solution-ar={project.salesDescriptionAr || project.salesDescription} 
            data-i18n={`project_${cleanId}_solution`}
          >
            {displaySalesDesc}
          </p>
        </div>

        <!-- Sales Funnel Impact Card (Highlight Card) -->
        <div class="details-card glass-card highlight-card">
          <div class="card-icon-header">
            <i class="fa-solid fa-chart-line"></i>
            <h2 data-i18n="project_metrics_label">Sales Funnel Impact</h2>
          </div>
          <p 
            class="details-card-text premium-highlight" 
            data-metrics-en={project.salesFunnelMetricsEn || project.salesFunnelMetrics} 
            data-metrics-ar={project.salesFunnelMetricsAr || project.salesFunnelMetrics} 
            data-i18n={`project_${cleanId}_metrics`}
          >
            {displayMetrics}
          </p>
        </div>

      </div>

      <!-- Right Column: Interactive Gallery & Live Dashboard Tabs -->
      <div class="project-details-media-col anim-child">
        <div class="media-container glass-card">
          
          {/* Tab Header */}
          {(() => {
            const imagesList: string[] = project.images || [];
            const hasImageGallery = imagesList.length > 0;
            const pdfAsset = (project.galleryItems && project.galleryItems.find((i: any) => i.type === 'pdf')) || (project.documentationUrl ? { type: 'pdf', title: 'PDF Documentation', url: project.documentationUrl } : null);
            const videoAsset = (project.galleryItems && project.galleryItems.find((i: any) => i.type === 'video')) || (project.videoUrl ? { type: 'video', title: 'Video Demo', url: project.videoUrl } : null);
            const foundPbiItem = project.galleryItems ? project.galleryItems.find((i: any) => i.type === 'powerbi') : null;
            const powerBiAsset: string | { url: string } | null = project.powerBiUrl || (foundPbiItem ? foundPbiItem.url : null);

            return (
              <>
                <div class="media-tabs">
                  {hasImageGallery && (
                    <button class="media-tab active" data-tab="gallery">
                      <i class="fa-solid fa-images"></i>
                      <span data-i18n="project_tab_gallery">Project Gallery</span>
                    </button>
                  )}
                  {pdfAsset && (
                    <button class={`media-tab ${!hasImageGallery ? 'active' : ''}`} data-tab="pdf">
                      <i class="fa-solid fa-file-pdf" style="color: #ef4444;"></i>
                      <span>{pdfAsset.title || 'PDF Document'}</span>
                    </button>
                  )}
                  {videoAsset && (
                    <button class={`media-tab ${!hasImageGallery && !pdfAsset ? 'active' : ''}`} data-tab="video">
                      <i class="fa-solid fa-circle-play" style="color: #3b82f6;"></i>
                      <span>{pdfAsset ? 'Video Walkthrough' : (videoAsset.title || 'Video Demo')}</span>
                    </button>
                  )}
                  {powerBiAsset && (
                    <button class={`media-tab ${!hasImageGallery && !pdfAsset && !videoAsset ? 'active' : ''}`} data-tab="dashboard">
                      <i class="fa-solid fa-chart-pie" style="color: #f59e0b;"></i>
                      <span data-i18n="project_tab_live">Live Interactive Dashboard</span>
                    </button>
                  )}
                </div>

                {/* Tab 1: Image Gallery */}
                {hasImageGallery && (
                  <div class="tab-content active" id="content-gallery">
                    <div class="gallery-main-view">
                      <Image 
                        src={resolveAsset(imagesList[0])} 
                        alt={`${project.title} main preview`} 
                        id="gallery-main-img" 
                        class="gallery-preview-img"
                        loading="eager"
                        width={800}
                        height={500}
                      />
                      <div class="glass-reflection-overlay"></div>
                    </div>

                    {imagesList.length > 1 && (
                      <div class="gallery-thumbnails">
                        {imagesList.map((imgUrl: string, idx: number) => (
                          <button 
                            class={`thumbnail-btn ${idx === 0 ? 'active' : ''}`} 
                            data-img={resolveAsset(imgUrl).src}
                            aria-label={`View screenshot ${idx + 1}`}
                          >
                            <Image src={resolveAsset(imgUrl)} alt="Thumbnail" loading="lazy" width={120} height={75} />
                          </button>
                        ))}
                      </div>
                    )}
                  </div>
                )}

                {/* Tab 2: Full In-Browser PDF Document Viewer (HTML5 Canvas Rendered) */}
                {pdfAsset && (
                  <div class={`tab-content ${!hasImageGallery ? 'active' : ''}`} id="content-pdf" data-pdf-raw-url={pdfAsset.url} data-pdf-proxy-url={`${import.meta.env.BASE_URL}api/pdf-proxy?url=${encodeURIComponent(pdfAsset.url)}`}>
                    <div class="pdf-viewer-header" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; padding: 12px 16px; background: rgba(15,23,42,0.9); border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); flex-wrap: wrap; gap: 10px;">
                      <div style="display: flex; align-items: center; gap: 10px;">
                        <i class="fa-solid fa-file-pdf" style="color: #ef4444; font-size: 20px;"></i>
                        <span style="font-weight: 600; font-size: 14px; color: #f8fafc;">{pdfAsset.title || 'PDF Interactive Document'}</span>
                      </div>
                      <div id="pdf-status-badge" style="font-size: 12px; color: #38bdf8; font-weight: 600; display: flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-circle-notch fa-spin"></i> Rendering Document Pages...
                      </div>
                    </div>
                    <div class="pdf-scroll-container" id="pdf-scroll-container" style="position: relative; width: 100%; max-height: 800px; background: #0f172a; border-radius: 8px; overflow-y: auto; display: flex; flex-direction: column; align-items: center; gap: 24px; padding: 24px 16px; border: 1px solid rgba(255,255,255,0.08); box-sizing: border-box;">
                      {/* Dynamic Canvases rendered by PDF.js Script */}
                    </div>
                  </div>
                )}

                {/* Tab 3: Video Player */}
                {videoAsset && (
                  <div class={`tab-content ${!hasImageGallery && !pdfAsset ? 'active' : ''}`} id="content-video">
                    <div style="padding: 12px;">
                      <video src={videoAsset.url} controls style="width: 100%; max-height: 600px; border-radius: 8px; background: #000;"></video>
                    </div>
                  </div>
                )}

                {/* Tab 4: Live Power BI Dashboard */}
                {powerBiAsset && (
                  <div class={`tab-content ${!hasImageGallery && !pdfAsset && !videoAsset ? 'active' : ''}`} id="content-dashboard">
                    <div class="dashboard-iframe-wrapper">
                      <iframe 
                        title={project.title} 
                        src={typeof powerBiAsset === 'string' ? powerBiAsset : (powerBiAsset as any).url} 
                        allowfullscreen
                        loading="lazy">
                      </iframe>
                    </div>
                    <div class="dashboard-notice">
                      <i class="fa-solid fa-circle-info"></i>
                      <p data-i18n="powerbi_notice">Note: If the Microsoft Power BI service is blocked on your network, use the media tabs above.</p>
                    </div>
                  </div>
                )}
              </>
            );
          })()}
        </div>
      </div>
      </div>

    </div>

    <!-- Bottom High-Converting Call-To-Action (CTA) -->
    <footer class="project-details-footer anim-child">
      <div class="cta-luxury-banner glass-card">
        <h2 data-i18n="project_cta_label">Inquire About This Service</h2>
        <p>Unlock optimized performance, streamlined operations, and high-impact analytics for your business today.</p>
        <a href={`${import.meta.env.BASE_URL}#contact`} class="btn-primary cta-btn">
          <span data-i18n="case_study_cta">Start a Similar Project</span>
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </footer>

  </div>
</Layout>

<script>
  function initProjectMedia() {
    const tabs = document.querySelectorAll('.media-tab');
    const contents = document.querySelectorAll('.tab-content');
    const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement;
    const thumbnails = document.querySelectorAll('.thumbnail-btn');
    const triggerDashBtn = document.getElementById('trigger-live-dash');

    // Tab switching
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        
        tabs.forEach(t => t.classList.remove('active'));
        contents.forEach(c => c.classList.remove('active'));
        
        tab.classList.add('active');
        const activeContent = document.getElementById(`content-${target}`);
        if (activeContent) activeContent.classList.add('active');
      });
    });

    // Thumbnail clicking
    thumbnails.forEach(thumb => {
      thumb.addEventListener('click', () => {
        const newSrc = thumb.getAttribute('data-img');
        if (!newSrc || !mainImg) return;

        thumbnails.forEach(t => t.classList.remove('active'));
        thumb.classList.add('active');

        // Smooth fade transition
        mainImg.style.opacity = '0';
        setTimeout(() => {
          mainImg.src = newSrc;
          mainImg.style.opacity = '1';
        }, 150);
      });
    });

    // CTA button switching to dashboard tab
    if (triggerDashBtn) {
      triggerDashBtn.addEventListener('click', () => {
        const dashTab = document.querySelector('.media-tab[data-tab="dashboard"]') as HTMLButtonElement;
        if (dashTab) dashTab.click();
      });
    }
  }

  initProjectMedia();
  document.addEventListener('astro:page-load', initProjectMedia);
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" is:inline></script>
<script is:inline>
  (function setupPdfDocumentView() {
    async function loadAndRenderPdf() {
      const pdfTab = document.getElementById('content-pdf');
      if (!pdfTab) return;

      const proxyUrl = pdfTab.getAttribute('data-pdf-proxy-url');
      const container = document.getElementById('pdf-scroll-container');
      const badge = document.getElementById('pdf-status-badge');
      if (!container || !proxyUrl) return;

      if (typeof pdfjsLib === 'undefined') {
        container.innerHTML = '<iframe src="' + proxyUrl + '" width="100%" height="750px" style="border:none;"></iframe>';
        return;
      }

      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

      try {
        const res = await fetch(proxyUrl);
        if (!res.ok) throw new Error('PDF proxy status ' + res.status);
        const buffer = await res.arrayBuffer();

        const pdfDoc = await pdfjsLib.getDocument({ data: buffer }).promise;
        container.innerHTML = '';

        if (badge) {
          badge.innerHTML = '<i class="fa-solid fa-file-circle-check" style="color: #4ade80;"></i> ' + pdfDoc.numPages + ' Pages Interactive View';
        }

        for (let pageNum = 1; pageNum <= pdfDoc.numPages; pageNum++) {
          const page = await pdfDoc.getPage(pageNum);
          const viewport = page.getViewport({ scale: 1.4 });

          const wrapper = document.createElement('div');
          wrapper.style.display = 'flex';
          wrapper.style.flexDirection = 'column';
          wrapper.style.alignItems = 'center';
          wrapper.style.width = '100%';
          wrapper.style.maxWidth = '900px';

          const pageLabel = document.createElement('div');
          pageLabel.style.fontSize = '12px';
          pageLabel.style.fontWeight = '600';
          pageLabel.style.color = '#94a3b8';
          pageLabel.style.marginBottom = '8px';
          pageLabel.style.alignSelf = 'flex-start';
          pageLabel.textContent = 'Page ' + pageNum + ' of ' + pdfDoc.numPages;

          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          canvas.height = viewport.height;
          canvas.width = viewport.width;
          canvas.style.width = '100%';
          canvas.style.height = 'auto';
          canvas.style.background = '#ffffff';
          canvas.style.boxShadow = '0 12px 36px rgba(0,0,0,0.5)';
          canvas.style.borderRadius = '6px';

          wrapper.appendChild(pageLabel);
          wrapper.appendChild(canvas);
          container.appendChild(wrapper);

          await page.render({ canvasContext: ctx, viewport: viewport }).promise;
        }
      } catch (err) {
        console.warn('PDF.js arrayBuffer render fallback:', err);
        if (badge) badge.innerHTML = '<i class="fa-solid fa-eye"></i> Native Document View';
        container.innerHTML = '<iframe src="' + proxyUrl + '" width="100%" height="750px" style="border:none; border-radius: 6px; background: #fff;"></iframe>';
      }
    }

    loadAndRenderPdf();
    document.addEventListener('astro:page-load', loadAndRenderPdf);
  })();
</script>

<style>
  /* --- Dedicated Page Container Styles --- */
  .project-details-page-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 95px 16px 60px 16px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    overflow-x: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  /* Integrated Header Top Bar Nav Actions */
  .project-header-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 8px;
  }

  .back-link-btn, .github-link-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(var(--surface-rgb), 0.5);
    border: 1px solid var(--border-card);
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
    min-height: 44px;
    white-space: nowrap;
  }

  .back-link-btn:hover, .github-link-btn:hover {
    color: var(--text);
    border-color: rgba(var(--accent-a-rgb), 0.3);
    background: rgba(var(--surface-rgb), 0.8);
    transform: translateY(-2px);
  }

  .back-link-btn i {
    transition: transform 0.25s ease;
  }

  .back-link-btn:hover i {
    transform: translateX(-4px);
  }

  html[dir="rtl"] .back-link-btn:hover i {
    transform: translateX(4px);
  }

  /* Header styles */
  .project-details-header {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .project-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    background: rgba(var(--accent-a-rgb), 0.1);
    border: 1px solid rgba(var(--accent-a-rgb), 0.2);
    border-radius: 999px;
    color: var(--accent-a);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    width: fit-content;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-a);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .project-details-title {
    font-size: clamp(26px, 5vw, 48px);
    font-weight: 800;
    color: var(--text);
    margin: 0;
    line-height: 1.2;
  }

  .project-details-tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-tag {
    font-size: 12px;
    padding: 5px 12px;
    background: var(--badge-bg);
    border-radius: 999px;
    color: var(--muted);
    border: 1px solid var(--badge-border);
  }

  /* Layout Grid — mobile first: single column, dashboard BEFORE content */
  .project-details-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "media"
      "content";
    gap: 24px;
    align-items: start;
  }

  .project-details-content-col {
    grid-area: content;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .project-details-media-col {
    grid-area: media;
    min-width: 0;
    overflow: hidden;
  }

  /* Cards */
  .details-card {
    padding: 20px;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: rgba(var(--surface-rgb), 0.4);
    border: 1px solid var(--border-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: transform 0.4s ease;
  }

  .details-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-card-hover);
  }

  /* disable hover lift on touch */
  @media (hover: none) {
    .details-card:hover {
      transform: none;
    }
  }

  .card-icon-header {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--accent-a);
  }

  .card-icon-header i {
    font-size: 20px;
    flex-shrink: 0;
  }

  .card-icon-header h2 {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    line-height: 1.3;
  }

  .details-card-text {
    font-size: 15px;
    color: var(--text);
    line-height: 1.7;
    margin: 0;
    opacity: 0.88;
  }

  /* Highlight Card */
  .highlight-card {
    border: 1px solid rgba(var(--accent-b-rgb), 0.3);
    background: linear-gradient(135deg, rgba(var(--surface-rgb), 0.6) 0%, rgba(var(--accent-b-rgb), 0.08) 100%);
  }

  .highlight-card .card-icon-header {
    color: var(--accent-b);
  }

  .premium-highlight {
    font-weight: 600;
    color: var(--text);
  }

  /* --- Interactive Media System Styles --- */
  .media-container {
    padding: 16px;
    border-radius: var(--radius);
    background: rgba(var(--surface-rgb), 0.4);
    border: 1px solid var(--border-card);
    backdrop-filter: blur(16px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Tab Header */
  .media-tabs {
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid var(--border-card);
    padding-bottom: 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .media-tabs::-webkit-scrollbar { display: none; }

  .media-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .media-tab:hover {
    color: var(--text);
    background: var(--badge-bg);
    opacity: 0.85;
  }

  .media-tab.active {
    color: #fff;
    background: var(--accent-a);
    border-color: var(--accent-a);
    box-shadow: 0 4px 15px rgba(var(--accent-a-rgb), 0.35);
  }

  /* Tab Contents */
  .tab-content {
    display: none;
    flex-direction: column;
    gap: 16px;
    animation: fadeIn 0.3s ease;
  }

  .tab-content.active {
    display: flex;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }

  /* Gallery View */
  .gallery-main-view {
    position: relative;
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border-card);
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
  }

  .gallery-preview-img {
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: contain;
    display: block;
    transition: opacity 0.2s ease;
  }

  .gallery-thumbnails {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-width: none;
  }
