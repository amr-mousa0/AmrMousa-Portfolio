---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/astro/Hero.astro';
import TrustBar from '../components/ui/TrustBar.astro';
import ServicesCarousel from '../components/sections/ServicesCarousel.astro';
import ProjectSlider from '../components/astro/ProjectSlider.astro';
import Contact from '../components/sections/Contact.astro';
import { ContentHubClient } from '../lib/content-hub/contentHubClient';

const currentLocale = Astro.currentLocale || 'en';
const { projects, error } = await ContentHubClient.getProjects('portfolio', currentLocale);
---

<Layout title="Amr Mousa — Portfolio">
  <Hero />
  <TrustBar />
  <ServicesCarousel />

  <section id="projects" aria-labelledby="projects-title">
    <div class="section-anim-container">
      <div class="section-inner" style="display: block;">
        <div class="section-header anim-child">
          <h2 id="projects-title" class="section-title left-aligned" data-i18n="projects_title">Case Studies</h2>
          <p class="section-subtitle" data-i18n="projects_subtitle">Real results from real projects. See how we drive growth.</p>
        </div>
        
        {error ? (
          <div class="projects-unavailable-banner glass-card" style="padding: 32px 24px; text-align: center; margin: 20px 0; border: 1px solid rgba(239, 68, 68, 0.3); background: rgba(239, 68, 68, 0.05); border-radius: 16px;">
            <i class="fa-solid fa-triangle-exclamation" style="font-size: 28px; color: #ef4444; margin-bottom: 12px; display: inline-block;"></i>
            <h3 style="margin: 8px 0; font-size: 18px; font-weight: 700; color: var(--text);">Projects Temporarily Unavailable</h3>
            <p style="color: var(--muted); font-size: 14px; margin: 0;">{error}</p>
          </div>
        ) : (
          <ProjectSlider projects={projects} />
        )}
      </div>
    </div>
  </section>

  <Contact />
</Layout>

